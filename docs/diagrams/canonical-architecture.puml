@startuml canonical-architecture
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #55506A
skinparam activity {
  FontSize 15
  FontColor #17132B
  BorderThickness 1.5
  BackgroundColor #FFFFFF
  BorderColor #55506A
}
skinparam ActivityDiamondFontSize 13
skinparam titleFontSize 20
skinparam titleFontColor #17132B
skinparam legendFontSize 13
skinparam legendBackgroundColor #F8F7FC
skinparam legendBorderColor #AAA6BA

title Foundgine — Canonical Architecture\nOne semantic lifecycle · one authorization boundary · many interfaces · many retrieval strategies

start

partition "Caller & Intent" #F3EFFF {
  :1 · Caller;
  :2 · Intent;
}

partition "Semantic Model" #EEF9EF {
  :3 · Semantic Model;
  :4 · Semantic Operation Graph;
}

partition "5 · Retrieval — parallel, discovers candidates, never grants authority" #FFF5E8 {
  fork
    :Relational;
  fork again
    :Fuzzy\n(pg_trgm);
  fork again
    :FullText\n(tsvector);
  fork again
    :BM25\n(pg_search, optional);
  fork again
    :AGE Graph\n(Apache AGE, optional);
  end fork
  :Candidates + Evidence;
}

partition "6 · Resolution" #FFF9EE {
  :Resolution;
}

partition "7-9 · Authorization, Plan Binding & Execution IR" #F0F5FF {
  :7 · Authorization;
  :8 · Plan Binding;
  :9 · Execution IR;
}

partition "10-12 · Provider, Execution & Evidence" #EDF9F3 {
  :10 · Provider;
  :11 · Execution;
  :12 · Evidence;
}

stop

legend right
  Non-negotiable invariants
  ==
  Retrieval is not authorization.
  The operation graph is resolved before provider planning.
  Authorization is bound to the executable plan.
  Provider optimization cannot remove security obligations.
  Final execution fails closed when provenance/conformance fails.
  Evidence records what happened; it does not grant authority.
endlegend
@enduml
