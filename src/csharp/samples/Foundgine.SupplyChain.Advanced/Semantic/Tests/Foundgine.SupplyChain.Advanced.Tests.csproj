         transitively through this reference. -->
    <ProjectReference Include="../../../../Foundgine.Providers/Foundgine.Providers.csproj" />
    <!-- Needed only by the Retrieval/* tests, which exercise
         PostgresRetrievalCandidateSource (Fuzzy/pg_trgm, FullText,
         Search/pg_search, GraphSimilarity/Apache AGE, and the reserved
         Vector strategy) against the Supply Chain semantic model. -->
  </ItemGroup>
