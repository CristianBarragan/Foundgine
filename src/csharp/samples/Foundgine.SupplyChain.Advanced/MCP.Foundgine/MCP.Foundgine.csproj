<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
    <ProjectReference Include="../../../Foundgine.Providers/Foundgine.Providers.csproj" />
    <ProjectReference Include="../../../Foundgine.Core/Foundgine.Core.csproj" />
    <ProjectReference Include="../../../Foundgine.Runtime/Foundgine.Runtime.csproj" />
    <ProjectReference Include="../../../Foundgine.Providers.Orm/Foundgine.Providers.Orm.csproj" />
    <ProjectReference Include="../../../Foundgine.Providers.EntityFrameworkCore/Foundgine.Providers.EntityFrameworkCore.csproj" />
    <!-- Emits Foundgine.Generated.Orm.GeneratedOrmMaps: typed ORM maps for every [FoundgineEntity] type. -->
    <ProjectReference
      Include="../../../Foundgine.Providers.Orm.Generator/Foundgine.Providers.Orm.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SkipGetTargetFrameworkProperties="true"
      UndefineProperties="TargetFramework"
    />
    <ProjectReference
      Include="../../../Foundgine.Providers/Foundgine.Providers.Aot.Generator/Foundgine.Providers.Aot.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SkipGetTargetFrameworkProperties="true"
      UndefineProperties="TargetFramework"
    />
  </ItemGroup>
</Project>
