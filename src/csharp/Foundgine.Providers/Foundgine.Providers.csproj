<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Foundgine</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageId>Foundgine.Providers</PackageId>
    <Description>Foundgine.Providers contains the concrete provider and integration implementations for Foundgine 3.x, including storage providers and adapters, AI/model and MCP tooling integrations, EventStore, gateway integrations, Elasticsearch and vector-store support, and the Entity Framework Core execution provider. The package includes Foundgine-owned ORM and EF Core assemblies plus the AOT and ORM source generators as build-time analyzers. EF Core and other third-party libraries are restored as NuGet dependencies and are not bundled as DLLs. Secure GraphQL/Hot Chocolate execution lives in Foundgine.Extensions alongside GraphQL translation. Consumers supply the semantic model and runtime configuration required by Foundgine.</Description>
    <PackageTags>providers;storage;orm;entity-framework-core;aot;ai;mcp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.Providers</RootNamespace>
    <AssemblyName>Foundgine.Providers</AssemblyName>
    <IsPackable>true</IsPackable>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"
                        PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never compile generated files from nested projects. -->
    <Compile Remove="**/obj/**/*.cs" />
    <Compile Remove="**/bin/**/*.cs" />

    <!-- These directories are independent projects or samples. -->
    <Compile Remove="Foundgine.Providers.Aot.Generator/**/*.cs" />

    <!-- ORM core, ORM generator and EF Core provider are top-level sibling projects. These guards keep a
         stale nested copy (e.g. left behind when a zip is extracted over an old tree) from being compiled
         into this assembly. -->
    <Compile Remove="Foundgine.Providers.Orm/**" />
    <Compile Remove="Foundgine.Providers.Orm.Generator/**" />
    <Compile Remove="Foundgine.Providers.EntityFrameworkCore/**" />
    <EmbeddedResource Remove="Foundgine.Providers.Orm/**;Foundgine.Providers.Orm.Generator/**;Foundgine.Providers.EntityFrameworkCore/**" />
    <None Remove="Foundgine.Providers.Orm/**;Foundgine.Providers.Orm.Generator/**;Foundgine.Providers.EntityFrameworkCore/**" />
    <Compile Remove="Samples/**/*.cs" />
    <Compile Remove="Gateway.Tests/**/*.cs" />
    <Compile Remove="EventStore.Tests/**/*.cs" />

    <EmbeddedResource Remove="Foundgine.Providers.Aot.Generator/**/*" />

    <None Remove="Foundgine.Providers.Aot.Generator/**/*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
            Include="EventStore/Schema/*.sql"
            LogicalName="Foundgine.Providers.EventStore.Schema.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="README.md"
          Condition="Exists('README.md')" />

    <None Include="../../../LICENSE"
          Pack="true"
          PackagePath="LICENSE" />

    <ProjectReference Include="../Foundgine.Core/Foundgine.Core.csproj" />
    <ProjectReference Include="../Foundgine.Runtime/Foundgine.Runtime.csproj" />

    <!--
      Build the ORM and EF Core components as part of this package, but do not
      create separate Foundgine package dependencies. Their Foundgine-owned
      assemblies and analyzers are added to this package by PackProviderComponents.
    -->
    <ProjectReference Include="../Foundgine.Providers.Orm/Foundgine.Providers.Orm.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.EntityFrameworkCore/Foundgine.Providers.EntityFrameworkCore.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <!-- Build-time AOT analyzer; not a runtime dependency. -->
    <ProjectReference
            Include="Foundgine.Providers.Aot.Generator/Foundgine.Providers.Aot.Generator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
            SkipGetTargetFrameworkProperties="true"
            UndefineProperties="TargetFramework" />

    <!-- EF Core is a consumer-restored dependency, never a DLL bundled in this package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <!-- Used by the bundled EF Core provider (AddFoundgineEf). Declared here because the EF project is a private
         reference, so its own package references do not flow to consumers. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />

    <PackageReference Include="Microsoft.Extensions.AI"
                      Version="10.9.0" />

    <PackageReference Include="ModelContextProtocol"
                      Version="2.2.0" />

    <PackageReference Include="Npgsql"
                      Version="10.0.3" />

    <PackageReference Include="Pgvector"
                      Version="0.3.2" />
  </ItemGroup>

  <Target Name="PackProviderComponents" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_AotGeneratorDll>$(MSBuildThisFileDirectory)Foundgine.Providers.Aot.Generator/bin/$(Configuration)/netstandard2.0/Foundgine.Providers.Aot.Generator.dll</_AotGeneratorDll>
      <_OrmGeneratorDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Orm.Generator/bin/$(Configuration)/netstandard2.0/Foundgine.Providers.Orm.Generator.dll</_OrmGeneratorDll>
      <_OrmAssembly>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Orm/bin/$(Configuration)/$(TargetFramework)/Foundgine.Providers.Orm.dll</_OrmAssembly>
      <_OrmXml>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Orm/bin/$(Configuration)/$(TargetFramework)/Foundgine.Providers.Orm.xml</_OrmXml>
      <_EfCoreAssembly>$(MSBuildThisFileDirectory)..\Foundgine.Providers.EntityFrameworkCore/bin/$(Configuration)/$(TargetFramework)/Foundgine.Providers.EntityFrameworkCore.dll</_EfCoreAssembly>
      <_EfCoreXml>$(MSBuildThisFileDirectory)..\Foundgine.Providers.EntityFrameworkCore/bin/$(Configuration)/$(TargetFramework)/Foundgine.Providers.EntityFrameworkCore.xml</_EfCoreXml>
    </PropertyGroup>

    <Error Condition="!Exists('$(_AotGeneratorDll)')"
           Text="AOT generator DLL not found: $(_AotGeneratorDll)" />
    <Error Condition="!Exists('$(_OrmGeneratorDll)')"
           Text="ORM generator DLL not found: $(_OrmGeneratorDll)" />
    <Error Condition="!Exists('$(_OrmAssembly)')"
           Text="ORM assembly not found: $(_OrmAssembly)" />
    <Error Condition="!Exists('$(_EfCoreAssembly)')"
           Text="EF Core provider assembly not found: $(_EfCoreAssembly)" />

    <ItemGroup>
      <!-- Only Foundgine-owned runtime assemblies are bundled. -->
      <None Include="$(_OrmAssembly)"
            Pack="true"
            PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Orm.dll"
            Visible="false" />
      <None Include="$(_EfCoreAssembly)"
            Pack="true"
            PackagePath="lib/$(TargetFramework)/Foundgine.Providers.EntityFrameworkCore.dll"
            Visible="false" />
      <None Include="$(_OrmXml)"
            Pack="true"
            PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Orm.xml"
            Visible="false"
            Condition="Exists('$(_OrmXml)')" />
      <None Include="$(_EfCoreXml)"
            Pack="true"
            PackagePath="lib/$(TargetFramework)/Foundgine.Providers.EntityFrameworkCore.xml"
            Visible="false"
            Condition="Exists('$(_EfCoreXml)')" />

      <!-- Both Foundgine source generators are compiler analyzers, not runtime assets. -->
      <None Include="$(_AotGeneratorDll)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/Foundgine.Providers.Aot.Generator.dll"
            Visible="false" />
      <None Include="$(_OrmGeneratorDll)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs/Foundgine.Providers.Orm.Generator.dll"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Items are removed here (not only in the ItemGroup above) so an explicit <Compile Include> added later by an
       IDE for a file under these folders cannot pull the ORM/EF/generator sources into this assembly. -->
  <Target Name="ExcludeSiblingProjectSources" BeforeTargets="BeforeCompile;CoreCompile;GenerateMSBuildEditorConfigFile">
    <ItemGroup>
      <Compile Remove="Foundgine.Providers.Orm/**" />
      <Compile Remove="Foundgine.Providers.Orm.Generator/**" />
      <Compile Remove="Foundgine.Providers.EntityFrameworkCore/**" />
      <Compile Remove="Foundgine.Providers.Aot.Generator/**" />
    </ItemGroup>
  </Target>
</Project>