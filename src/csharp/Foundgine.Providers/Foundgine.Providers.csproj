<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Foundgine</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Foundgine.Providers contains the concrete provider and integration implementations for Foundgine 3.x, including SQL and in-memory storage providers, AI/model and MCP tooling integrations, EventStore, outbox and gateway integrations, and the Entity Framework Core execution provider. The package includes Foundgine-owned ORM and EF Core assemblies and the AOT and ORM source generators as build-time analyzers. The Redis, Microsoft Agent Framework, PostgreSQL pgvector and Elasticsearch integrations are separate optional packages (Foundgine.Providers.Redis, .AgentFramework, .PostgresVector, .Elasticsearch). EF Core and other third-party libraries are restored as NuGet dependencies and are not bundled as DLLs. Secure GraphQL/Hot Chocolate execution lives in Foundgine.Extensions alongside GraphQL translation. Consumers supply the semantic model and runtime configuration required by Foundgine.</Description>
    <PackageTags>providers;storage;orm;entity-framework-core;aot;ai;mcp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.Providers</RootNamespace>
    <AssemblyName>Foundgine.Providers</AssemblyName>
    <!-- Bundled into the Foundgine.Providers package by Foundgine.Providers.Package; not published on its own. -->
    <IsPackable>false</IsPackable>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"
                        PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never compile generated files from nested projects. -->
    <Compile Remove="**/obj/**/*.cs" />
    <Compile Remove="**/bin/**/*.cs" />

    <!-- Every optional integration (ORM, ORM and AOT generators, EF Core, Redis, Agent Framework, pgvector,
         Elasticsearch) is a top-level sibling project: src/csharp/Foundgine.Providers.<Name>. These guards keep
         a stale nested copy (e.g. left behind when a zip is extracted over an old tree) from being compiled
         into this assembly. ci/verify-no-stale-nested-projects.sh also fails the build on such a copy. -->
    <Compile Remove="Foundgine.Providers.*/**" />
    <EmbeddedResource Remove="Foundgine.Providers.*/**" />
    <None Remove="Foundgine.Providers.*/**" />
    <Compile Remove="Samples/**/*.cs" />
    <Compile Remove="Gateway.Tests/**/*.cs" />
    <Compile Remove="EventStore.Tests/**/*.cs" />

  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
            Include="EventStore/Schema/*.sql"
            LogicalName="Foundgine.Providers.EventStore.Schema.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="README.md"
          Condition="Exists('README.md')" />
    <None Include="../../../LICENSE"
          Pack="true"
          PackagePath="LICENSE" />

    <ProjectReference Include="../Foundgine.Core/Foundgine.Core.csproj" />
    <ProjectReference Include="../Foundgine.Runtime/Foundgine.Runtime.csproj" />

    <!--
      Build the ORM and EF Core components as part of this package, but do not
      create separate Foundgine package dependencies. Their Foundgine-owned
      assemblies and analyzers are packed by Foundgine.Providers.Package (the only packable provider project).
    -->
    <ProjectReference Include="../Foundgine.Providers.Orm/Foundgine.Providers.Orm.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.EntityFrameworkCore/Foundgine.Providers.EntityFrameworkCore.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />

    <!-- Build-time AOT analyzer; not a runtime dependency. -->
    <ProjectReference
            Include="../Foundgine.Providers.Aot.Generator/Foundgine.Providers.Aot.Generator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
            SkipGetTargetFrameworkProperties="true"
            UndefineProperties="TargetFramework" />

    <!-- EF Core is a consumer-restored dependency, never a DLL bundled in this package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <!-- Used by the bundled EF Core provider (AddFoundgineEf). Declared here because the EF project is a private
         reference, so its own package references do not flow to consumers. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />

    <PackageReference Include="Microsoft.Extensions.AI"
                      Version="10.9.0" />

    <PackageReference Include="ModelContextProtocol"
                      Version="2.2.0" />

    <PackageReference Include="Npgsql"
                      Version="10.0.3" />

  </ItemGroup>

  <!-- Items are removed here (not only in the ItemGroup above) so an explicit <Compile Include> added later by an
       IDE for a file under these folders cannot pull the ORM/EF/generator sources into this assembly. -->
  <Target Name="ExcludeSiblingProjectSources" BeforeTargets="BeforeCompile;CoreCompile;GenerateMSBuildEditorConfigFile">
    <ItemGroup>
      <Compile Remove="Foundgine.Providers.*/**" />
    </ItemGroup>
  </Target>
</Project>