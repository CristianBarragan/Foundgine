<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>

    <Authors>Foundgine</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageId>Foundgine.Providers.EntityFrameworkCore</PackageId>
    <AssemblyName>Foundgine.Providers.EntityFrameworkCore</AssemblyName>
    <RootNamespace>Foundgine.Providers.EntityFrameworkCore</RootNamespace>
    <Description>Entity Framework Core execution provider for Foundgine. Integrates EF Core with Foundgine's provider-neutral execution contracts and shared ORM execution infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Foundgine core execution contracts -->
    <ProjectReference Include="../Foundgine.Core/Foundgine.Core.csproj" />

    <!-- Shared ORM execution infrastructure -->
    <ProjectReference Include="../Foundgine.Providers.Orm/Foundgine.Providers.Orm.csproj" />
  </ItemGroup>

</Project>
