<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Foundgine</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageId>Foundgine.Providers.Redis</PackageId>
    <Description>Shared state for horizontally scaled Foundgine hosts over the Redis protocol (Redis, Valkey, or Microsoft Garnet, which is built on FASTER): atomic warrant replay protection, shared monotonic warrant revocation (ISecurityWarrantRevocationStore), and a shared MCP session store (IFoundgineMcpSessionStore, one Lua script per operation). Both fail closed when the server is unreachable.</Description>
    <PackageTags>providers;redis;garnet;faster;security;warrants;replay;mcp;sessions;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Foundgine.Providers.Redis</RootNamespace>
    <AssemblyName>Foundgine.Providers.Redis</AssemblyName>
    <!-- Bundled into the Foundgine.Providers package by Foundgine.Providers.Package; not published on its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" Condition="Exists('README.md')" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <ProjectReference Include="../Foundgine.Core/Foundgine.Core.csproj" />
    <!-- The MCP session store implements IFoundgineMcpSessionStore, which lives in Foundgine.Providers. -->
    <ProjectReference Include="../Foundgine.Providers/Foundgine.Providers.csproj" />
    <!-- Pinned deliberately; confirm this version restores from your feed and bump as needed. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.37" />
  </ItemGroup>
</Project>
