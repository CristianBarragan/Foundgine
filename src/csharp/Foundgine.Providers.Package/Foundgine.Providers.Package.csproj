<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Packaging-only project. It produces the single Foundgine.Providers NuGet package, which bundles the Foundgine-owned
    assemblies of every provider project (Providers, ORM, EF Core, Redis, Microsoft Agent Framework, pgvector,
    Elasticsearch) plus the AOT and ORM generators as analyzers. It contains no code of its own. This mirrors the Java
    side, where foundgine-providers is one Maven artifact.

    The bundled projects stay separate projects (they reference Foundgine.Providers, so they cannot be compiled into
    it) and are marked IsPackable=false. Their third-party dependencies are declared below as package dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Foundgine</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageId>Foundgine.Providers</PackageId>
    <Description>Foundgine.Providers contains the concrete provider and integration implementations for Foundgine 3.x: SQL and in-memory storage providers, AI/model and MCP tooling integrations, EventStore, outbox and gateway integrations, the Entity Framework Core execution provider and shared ORM core, Redis-protocol shared state (Redis, Valkey, Garnet), the Microsoft Agent Framework adapter, PostgreSQL pgvector and Elasticsearch lexical grounding. The package includes the AOT and ORM source generators as build-time analyzers. EF Core and other third-party libraries are restored as NuGet dependencies and are not bundled as DLLs. Secure GraphQL/Hot Chocolate execution, Temporal and Keycloak live in Foundgine.Extensions. Consumers supply the semantic model and runtime configuration required by Foundgine.</Description>
    <PackageTags>providers;storage;orm;entity-framework-core;redis;agent-framework;pgvector;elasticsearch;aot;ai;mcp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <!-- No assembly is packed from this project's own output; the lib/ assemblies are added by BundleProviderAssemblies. -->
    <NoWarn>$(NoWarn);NU5128;NU5017</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../Foundgine.Providers/README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="LICENSE" />

    <!-- Declared package dependencies (Foundgine.Core and Foundgine.Runtime at the same version). -->
    <ProjectReference Include="../Foundgine.Core/Foundgine.Core.csproj" />
    <ProjectReference Include="../Foundgine.Runtime/Foundgine.Runtime.csproj" />

    <!-- Built first, bundled by BundleProviderAssemblies, never a package dependency. -->
    <ProjectReference Include="../Foundgine.Providers/Foundgine.Providers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.Orm/Foundgine.Providers.Orm.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.EntityFrameworkCore/Foundgine.Providers.EntityFrameworkCore.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.Redis/Foundgine.Providers.Redis.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.AgentFramework/Foundgine.Providers.AgentFramework.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.PostgresVector/Foundgine.Providers.PostgresVector.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.Elasticsearch/Foundgine.Providers.Elasticsearch.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.Orm.Generator/Foundgine.Providers.Orm.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Foundgine.Providers.Aot.Generator/Foundgine.Providers.Aot.Generator.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" UndefineProperties="TargetFramework" />

    <!-- Third-party dependencies of the bundled assemblies (restored by consumers, never bundled). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.37" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.5.0" />
  </ItemGroup>

  <Target Name="BundleProviderAssemblies" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_Foundgine_ProvidersDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.dll</_Foundgine_ProvidersDll>
      <_Foundgine_Providers_OrmDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Orm\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.Orm.dll</_Foundgine_Providers_OrmDll>
      <_Foundgine_Providers_EntityFrameworkCoreDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.EntityFrameworkCore\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.EntityFrameworkCore.dll</_Foundgine_Providers_EntityFrameworkCoreDll>
      <_Foundgine_Providers_RedisDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Redis\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.Redis.dll</_Foundgine_Providers_RedisDll>
      <_Foundgine_Providers_AgentFrameworkDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.AgentFramework\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.AgentFramework.dll</_Foundgine_Providers_AgentFrameworkDll>
      <_Foundgine_Providers_PostgresVectorDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.PostgresVector\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.PostgresVector.dll</_Foundgine_Providers_PostgresVectorDll>
      <_Foundgine_Providers_ElasticsearchDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Elasticsearch\bin\$(Configuration)\$(TargetFramework)\Foundgine.Providers.Elasticsearch.dll</_Foundgine_Providers_ElasticsearchDll>
      <_AotGeneratorDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Aot.Generator\bin\$(Configuration)\netstandard2.0\Foundgine.Providers.Aot.Generator.dll</_AotGeneratorDll>
      <_OrmGeneratorDll>$(MSBuildThisFileDirectory)..\Foundgine.Providers.Orm.Generator\bin\$(Configuration)\netstandard2.0\Foundgine.Providers.Orm.Generator.dll</_OrmGeneratorDll>
    </PropertyGroup>

    <Error Condition="!Exists('$(_Foundgine_ProvidersDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_ProvidersDll)" />
    <Error Condition="!Exists('$(_Foundgine_Providers_OrmDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_Providers_OrmDll)" />
    <Error Condition="!Exists('$(_Foundgine_Providers_EntityFrameworkCoreDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_Providers_EntityFrameworkCoreDll)" />
    <Error Condition="!Exists('$(_Foundgine_Providers_RedisDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_Providers_RedisDll)" />
    <Error Condition="!Exists('$(_Foundgine_Providers_AgentFrameworkDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_Providers_AgentFrameworkDll)" />
    <Error Condition="!Exists('$(_Foundgine_Providers_PostgresVectorDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_Providers_PostgresVectorDll)" />
    <Error Condition="!Exists('$(_Foundgine_Providers_ElasticsearchDll)')" Text="Assembly not found (build the solution first): $(_Foundgine_Providers_ElasticsearchDll)" />
    <Error Condition="!Exists('$(_AotGeneratorDll)')" Text="AOT generator DLL not found: $(_AotGeneratorDll)" />
    <Error Condition="!Exists('$(_OrmGeneratorDll)')" Text="ORM generator DLL not found: $(_OrmGeneratorDll)" />

    <PropertyGroup>
      <_Foundgine_ProvidersXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_ProvidersDll)', '.xml'))</_Foundgine_ProvidersXml>
      <_Foundgine_Providers_OrmXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_Providers_OrmDll)', '.xml'))</_Foundgine_Providers_OrmXml>
      <_Foundgine_Providers_EntityFrameworkCoreXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_Providers_EntityFrameworkCoreDll)', '.xml'))</_Foundgine_Providers_EntityFrameworkCoreXml>
      <_Foundgine_Providers_RedisXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_Providers_RedisDll)', '.xml'))</_Foundgine_Providers_RedisXml>
      <_Foundgine_Providers_AgentFrameworkXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_Providers_AgentFrameworkDll)', '.xml'))</_Foundgine_Providers_AgentFrameworkXml>
      <_Foundgine_Providers_PostgresVectorXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_Providers_PostgresVectorDll)', '.xml'))</_Foundgine_Providers_PostgresVectorXml>
      <_Foundgine_Providers_ElasticsearchXml>$([System.IO.Path]::ChangeExtension('$(_Foundgine_Providers_ElasticsearchDll)', '.xml'))</_Foundgine_Providers_ElasticsearchXml>
    </PropertyGroup>
    <ItemGroup>
      <!-- Only Foundgine-owned assemblies are bundled. Third-party libraries are declared as NuGet dependencies. -->
      <None Include="$(_Foundgine_ProvidersDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.dll" Visible="false" />
      <None Include="$(_Foundgine_ProvidersXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.xml" Visible="false" Condition="Exists('$(_Foundgine_ProvidersXml)')" />
      <None Include="$(_Foundgine_Providers_OrmDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Orm.dll" Visible="false" />
      <None Include="$(_Foundgine_Providers_OrmXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Orm.xml" Visible="false" Condition="Exists('$(_Foundgine_Providers_OrmXml)')" />
      <None Include="$(_Foundgine_Providers_EntityFrameworkCoreDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.EntityFrameworkCore.dll" Visible="false" />
      <None Include="$(_Foundgine_Providers_EntityFrameworkCoreXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.EntityFrameworkCore.xml" Visible="false" Condition="Exists('$(_Foundgine_Providers_EntityFrameworkCoreXml)')" />
      <None Include="$(_Foundgine_Providers_RedisDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Redis.dll" Visible="false" />
      <None Include="$(_Foundgine_Providers_RedisXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Redis.xml" Visible="false" Condition="Exists('$(_Foundgine_Providers_RedisXml)')" />
      <None Include="$(_Foundgine_Providers_AgentFrameworkDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.AgentFramework.dll" Visible="false" />
      <None Include="$(_Foundgine_Providers_AgentFrameworkXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.AgentFramework.xml" Visible="false" Condition="Exists('$(_Foundgine_Providers_AgentFrameworkXml)')" />
      <None Include="$(_Foundgine_Providers_PostgresVectorDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.PostgresVector.dll" Visible="false" />
      <None Include="$(_Foundgine_Providers_PostgresVectorXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.PostgresVector.xml" Visible="false" Condition="Exists('$(_Foundgine_Providers_PostgresVectorXml)')" />
      <None Include="$(_Foundgine_Providers_ElasticsearchDll)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Elasticsearch.dll" Visible="false" />
      <None Include="$(_Foundgine_Providers_ElasticsearchXml)" Pack="true" PackagePath="lib/$(TargetFramework)/Foundgine.Providers.Elasticsearch.xml" Visible="false" Condition="Exists('$(_Foundgine_Providers_ElasticsearchXml)')" />

      <!-- Both Foundgine source generators are compiler analyzers, not runtime assets. -->
      <None Include="$(_AotGeneratorDll)" Pack="true" PackagePath="analyzers/dotnet/cs/Foundgine.Providers.Aot.Generator.dll" Visible="false" />
      <None Include="$(_OrmGeneratorDll)" Pack="true" PackagePath="analyzers/dotnet/cs/Foundgine.Providers.Orm.Generator.dll" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
