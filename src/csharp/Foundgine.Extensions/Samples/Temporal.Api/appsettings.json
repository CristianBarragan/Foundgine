{
  "Temporal": {
    "Address": "localhost:7233",
    "Namespace": "default",
    "TaskQueue": "foundgine"
  },
  "Foundgine": {
    "Keycloak": {
      "Authority": "http://localhost:8080/realms/foundgine",
      "RequireHttpsMetadata": false,
      "Audience": "foundgine-api",
      "TenantClaim": "tenant_id",
      "WarrantAudience": "foundgine",
      "WarrantKeyId": "foundgine-warrant-1",
      "WarrantPrivateKeyPemPath": "/run/secrets/foundgine-warrant-key.pem",
      "RoleGrants": {
        "foundgine-user": [
          {
            "Capability": "orders",
            "Operation": "read",
            "ResourceScopes": []
          },
          {
            "Capability": "orders",
            "Operation": "write",
            "ResourceScopes": []
          }
        ],
        "foundgine-workflow-approver": [
          {
            "Capability": "orders",
            "Operation": "approve",
            "ResourceScopes": []
          }
        ]
      },
      "TrustedWarrantPublicKeys": {
        "foundgine-worker-1": "/run/secrets/foundgine-worker-1.pub.pem"
      }
    }
  }
}
