<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <!-- Connection settings are supplied at runtime by Main (SHOP_DB_URL). The schema comes from ../db/init.sql. -->
  <persistence-unit name="foundgine-shop" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.foundgine.samples.comparison.shop.CustomerEntity</class>
    <class>com.foundgine.samples.comparison.shop.ProductEntity</class>
    <class>com.foundgine.samples.comparison.shop.OrderEntity</class>
    <class>com.foundgine.samples.comparison.shop.OrderLineEntity</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
