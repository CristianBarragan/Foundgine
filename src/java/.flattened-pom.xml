<?xml version="1.0" encoding="UTF-8"?>
<!--
  Foundgine — Java implementation

  Module layout:

    foundgine-core          [core semantic execution boundary]
    foundgine-extensions    [transport adapters, layered independently]
    foundgine-providers     [storage/execution providers]
    foundgine-runtime       [application-facing runtime]
    */src/test/java         [test suites]
    samples/*               [sample applications]
    benchmarks/*            [performance benchmarks]
    security/foundgine-redteam [security test suite]

  Modules are added to this parent in dependency order (Core first, since
  everything else depends on it).
-->
