# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Sources that must always be LF, regardless of platform.
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.config text eol=lf

# Windows-specific scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts keep LF.
*.sh text eol=lf

# Binary assets: never diff/merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.pfx binary
*.snk binary

# Source-generated files: hide from GitHub's language stats / diffs.
**/GeneratedMetadata.g.cs linguist-generated=true
**/*.GlobalUsings.g.cs linguist-generated=true
**/obj/** linguist-generated=true
